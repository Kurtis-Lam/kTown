{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "redirects": [
    { "source": "/ktown.html", "destination": "/", "permanent": true },
    { "source": "/kauranotes.html", "destination": "/kauranotes/", "permanent": true },
    { "source": "/kcitethisforme.html", "destination": "/kcitethisforme/", "permanent": true },
    { "source": "/kauranotes", "destination": "/kauranotes/", "permanent": true },
    { "source": "/kcitethisforme", "destination": "/kcitethisforme/", "permanent": true },
    { "source": "/krevisionnotes", "destination": "/krevisionnotes/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/ktown/index.html" }
  ],
  "headers": [
    { "source": "/(.*)/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/imgs/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
