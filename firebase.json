{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "redirects": [
      { "source": "/ktown.html", "destination": "/", "type": 301 },
      { "source": "/kauranotes.html", "destination": "/kauranotes/", "type": 301 },
      { "source": "/kcitethisforme.html", "destination": "/kcitethisforme/", "type": 301 },
      { "source": "/kauranotes", "destination": "/kauranotes/", "type": 301 },
      { "source": "/kcitethisforme", "destination": "/kcitethisforme/", "type": 301 },
      { "source": "/krevisionnotes", "destination": "/krevisionnotes/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/", "destination": "/ktown/index.html" }
    ],
    "headers": [
      { "source": "**/vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/imgs/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
