rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- kTown (your existing rule, unchanged) ----
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- kRevisionNotes additions (friends + friend codes) ----
    // Progress itself lives in users/{uid}/private/progress, already covered by the rule above.
    // The block below only adds: friends can read each other's public profile summary
    // (level, XP, streak, badges, subject %), plus friend codes, requests and friend lists.
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isFriendOf(uid) { return exists(/databases/$(database)/documents/friends/$(uid)/list/$(me())); }

    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isFriendOf(uid));
      allow write: if signedIn() && me() == uid;
    }

    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && request.resource.data.keys().hasOnly(["uid"]);
      allow update, delete: if false;
    }

    match /requests/{to}/from/{from} {
      allow read: if signedIn() && (me() == to || me() == from);
      allow create: if signedIn() && me() == from && from != to;
      allow delete: if signedIn() && (me() == to || me() == from);
    }

    match /friends/{uid}/list/{fid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && (
        (me() == uid && exists(/databases/$(database)/documents/requests/$(uid)/from/$(fid))) ||
        (me() == fid && exists(/databases/$(database)/documents/requests/$(fid)/from/$(uid)))
      );
      allow delete: if signedIn() && (me() == uid || me() == fid);
    }
  }
}
